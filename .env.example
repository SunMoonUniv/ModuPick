# ═══════════════════════════════════════════════════════════════════════════
# ModuPick — docker compose 설정
#
# 이 파일을 .env로 복사해서 쓴다. .env는 저장소에 올라가지 않는다.
#
#   cp .env.example .env
#
# root와 migrator 비밀번호는 스키마를 통째로 지울 수 있는 권한이다. 아래 기본값을
# 그대로 두지 말고 배포 전에 바꾼다.
# ═══════════════════════════════════════════════════════════════════════════

# ── DB 계정 ────────────────────────────────────────────────────────────────
# 애플리케이션이 쓰는 계정은 사용자 이름도 비밀번호도 modupick이다.
# db_migration/sql/0090_grants.sql이 그 값으로 계정을 만든다.
#
# 값을 바꾸려면 아래를 고치고 DB 쪽 비밀번호도 함께 맞춘다 — 볼륨에 이미 만들어진
# 계정은 이 파일을 고쳐도 바뀌지 않는다. 컨테이너를 다시 만들거나(docker compose
# down -v) ALTER USER로 직접 맞춘다.
#
# 영문·숫자만 쓴다. DATABASE_URL 안에 들어가므로 / 나 @ 가 있으면 주소가 깨진다.
MODUPICK_APP_PASSWORD=modupick

# 아래 둘은 스키마를 통째로 지울 수 있는 권한이다. 여기 적힌 값은 로컬 개발용이므로
# 밖에 낼 서버에서는 무작위 문자열로 바꾼다.

# MySQL 관리자.
MYSQL_ROOT_PASSWORD=devroot

# 마이그레이션 전용 계정(CREATE·DROP·ALTER). 애플리케이션 런타임은 쓰지 않는다.
# 비워 두면 0090_grants.sql의 기본값이 그대로 남는다.
MODUPICK_MIGRATOR_PASSWORD=migratorpass


# ── 주소 ───────────────────────────────────────────────────────────────────
# 브라우저가 접속할 포트. 프론트(nginx)가 여기로 뜨고 /api·/ws를 백엔드로 넘긴다.
WEB_PORT=8080

# vite dev 서버(npm run dev)로 붙을 때만 쓰는 값이다. 쉼표로 여러 개를 줄 수 있고
# 값에 공백을 넣지 않는다. 배포에서는 프론트와 백엔드가 같은 오리진이라 쓰이지 않는다.
CORS_ORIGINS=http://localhost:5173

# 백엔드를 호스트의 어느 포트로 낼지. 127.0.0.1에만 바인딩되므로 밖에서는 보이지 않고,
# /docs를 열어 보거나 vite dev 서버가 프록시할 때만 쓴다.
BACKEND_PORT=8000

# MySQL을 호스트의 어느 포트로 낼지. 127.0.0.1에만 바인딩되므로 외부에서는
# 접근할 수 없고, 서버에 들어가 mysql 클라이언트로 볼 때만 쓴다.
DB_PORT=3307


# ── 동작 ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# 검증 콘솔(/devtools/console.html). 임의의 소켓 프레임을 보낼 수 있는 화면이라
# 배포에서는 false로 둔다.
DEVTOOLS_ENABLED=false

# 리버스 프록시를 앞에 둘 때만 true로 둔다. 프록시 없이 켜면 X-Forwarded-For 헤더를
# 위조해 방 조회 상한을 우회할 수 있다.
# 이 compose는 frontend(nginx)를 항상 앞에 두므로 true가 맞다. 백엔드만 따로 띄워
# 8000번으로 직접 붙는 구성이라면 false로 되돌린다.
TRUST_PROXY=true


# ── Cloudflare 터널 ────────────────────────────────────────────────────────
# 밖에서 접속하게 할 때만 채운다. 공유기 포트를 열지 않고 TLS까지 터널이 끝낸다.
# Cloudflare 대시보드 Zero Trust → Networks → Tunnels에서 터널을 만들면 나오는 토큰을
# 붙여 넣고, 그 터널의 public hostname을 http://frontend:80 으로 건다.
#
#   docker compose --profile tunnel up -d
#
# 비워 두면 터널 컨테이너는 뜨지 않는다(프로필로 분리해 뒀다). 나머지는 그대로 돈다.
CF_TUNNEL_TOKEN=
