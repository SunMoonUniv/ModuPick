# ═══════════════════════════════════════════════════════════════════════════
# ModuPick — docker compose 설정
#
# 이 파일을 .env로 복사해서 쓴다. .env는 저장소에 올라가지 않는다.
#
#   cp .env.example .env
#
# EC2에서는 ./bootstrap.sh가 자동으로 만든다.
# ═══════════════════════════════════════════════════════════════════════════

# ── DB 계정 ────────────────────────────────────────────────────────────────
# 애플리케이션이 쓰는 계정은 사용자 이름도 비밀번호도 modupick이다.
# db_migration/sql/0090_grants.sql이 그 값으로 계정을 만든다.
#
# 값을 바꾸려면 아래를 고친 뒤 ./bootstrap.sh를 다시 실행한다 — 스크립트가
# ALTER USER로 DB 쪽 비밀번호까지 맞춘다.
#
# 영문·숫자만 쓴다. DATABASE_URL 안에 들어가므로 / 나 @ 가 있으면 주소가 깨진다.
MODUPICK_APP_PASSWORD=modupick

# 아래 둘은 스키마를 통째로 지울 수 있는 권한이라 기본값을 그대로 두지 않는다 —
# bootstrap.sh가 무작위 문자열로 바꿔 .env에 적고 chmod 600으로 잠근다.
# 여기 적힌 값은 로컬 개발용이다.

# MySQL 관리자.
MYSQL_ROOT_PASSWORD=devroot

# 마이그레이션 전용 계정(CREATE·DROP·ALTER). 애플리케이션 런타임은 쓰지 않는다.
# 비워 두면 0090_grants.sql의 기본값이 그대로 남는다.
MODUPICK_MIGRATOR_PASSWORD=migratorpass


# ── 주소 ───────────────────────────────────────────────────────────────────
# 프론트엔드 주소다. 쉼표로 여러 개를 줄 수 있다. 여기 없는 출처에서 온 요청은
# 브라우저가 CORS로 막는다. 값에 공백을 넣지 않는다.
CORS_ORIGINS=http://localhost:5173

# 백엔드를 호스트의 어느 포트로 낼지. EC2 보안 그룹에서 같은 포트를 열어야 한다.
BACKEND_PORT=8000

# MySQL을 호스트의 어느 포트로 낼지. 127.0.0.1에만 바인딩되므로 외부에서는
# 접근할 수 없고, 서버에 들어가 mysql 클라이언트로 볼 때만 쓴다.
DB_PORT=3307


# ── 동작 ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# 검증 콘솔(/devtools/console.html). 임의의 소켓 프레임을 보낼 수 있는 화면이라
# 배포에서는 false로 둔다.
DEVTOOLS_ENABLED=false

# 리버스 프록시(Nginx·ALB)를 앞에 둘 때만 true로 바꾼다. 프록시 없이 켜면
# X-Forwarded-For 헤더를 위조해 방 조회 상한을 우회할 수 있다.
TRUST_PROXY=false
